#!/usr/bin/env python3
"""mail_check — periodic Gmail check that pushes a short Telegram summary.

Classifies mail into two tiers:
  IMPORTANT — alert on Telegram immediately
  DIGEST    — only counts in the periodic digest; never alerts on its own

Heuristics (all signals combined; any one promotes to IMPORTANT):

  IMPORTANT signals:
    - Gmail "CATEGORY_PERSONAL" or "CATEGORY_PROMOTIONS"? no — those are
      actually low-priority. We use CATEGORY_PRIMARY (Gmail's own Primary tab).
    - X-Gmail-Labels contains "Important" (Gmail's own importance classifier).
    - Subject or From matches a high-signal keyword (job, interview, offer,
      visa, loan, bank-OTP/transaction, deadline, urgent, asap, invoice,
      payment, scholarship, admit, selected, offer, internship, recruiter).
    - From address is a real domain the user has been emailing (we don't know
      yet — first run will learn from being told).
    - Subject starts with "Re:" (someone replied to his mail) AND not from a
      known bot/notification sender.
    - Calendar invite (.ics attachment).

  DEMOTE to digest-only (overrides everything except explicit IMPORTANT
  keyword match):
    - Senders matching: noreply / no-reply / notifications / jobalerts /
      mailing-list / digest / alerts@ / news@
    - Subject or label contains a notification-system pattern: "[repo] (#N)
      - ...", "Your daily digest", "Top stories", "Trending".
    - The Gmail category is CATEGORY_PROMOTIONS / CATEGORY_UPDATES /
      CATEGORY_FORUMS (Gmail itself ranks them low).
    - Subject begins with "[GitHub]" / "[ICML]" / "Welcome to" with a known
      newsletter provider.

State:
  ~/.local/state/mail_check/last_seen_uid — UIDs already announced, to avoid
  re-alerting on the same mail.
"""
from __future__ import annotations

import argparse
import email as emaillib
import email.policy
import imaplib
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timezone
from email.utils import parsedate_to_datetime
from pathlib import Path

# Reuse the XOAUTH2 client
sys.path.insert(0, os.path.expanduser("~/.local/bin"))
# `mail` is a script with no .py; re-import the helpers via a small shim
sys.path.insert(0, os.path.dirname(os.path.expanduser("~/.local/bin/mail")))

IMAP_HOST = "imap.gmail.com"
STATE_DIR = Path.home() / ".local/state/mail_check"
STATE_DIR.mkdir(parents=True, exist_ok=True)
SEEN_FILE = STATE_DIR / "last_seen_uid.json"

# ---------------------------------------------------------------------------
# Classification
# ---------------------------------------------------------------------------

# Promote to IMPORTANT if any of these words appear in subject OR from-line.
# Lowercased matching.
IMPORTANT_KEYWORDS = [
    # Career / opportunities
    "interview", "offer letter", "offer of", "shortlist", "shortlisted",
    "selected", "selection", "admission", "admit", "scholarship",
    "internship", "recruiter", "hiring", "job offer", "position",
    "on-campus", "placement",
    # Finance
    "invoice", "payment", "transaction", "refund", "charged", "credited",
    "debited", "otp", "kyc", "loan", "emi", "tax", "gst", "salary",
    # Urgency
    "urgent", "asap", "deadline", "expires", "expiring", "action required",
    "please respond", "awaiting your reply", "follow up", "reminder",
    # Personal
    "visa", "passport", "ticket", "booking", "confirmed",
    # Direct replies to you
    "fwd:", "fw:",
]

# If the From header looks like this, demote to digest.
# But some "noreply" senders ARE important (LinkedIn job alerts the user
# opted into). Those are handled by JOB_ALERT_SENDERS below.
DEMOTE_SENDERS = [
    "notifications@", "alerts@", "newsletter", "mailinglist", "digest",
    "marketing", "promo", "deals", "offers@",
    "substack", "reddit",
    "discussions-watched",  # HF discussions-watched
    "notifications@github", "notifications.huggingface",  # HF + GH
    "do-not-reply", "donotreply",
    "noreplyubi",  # Union Bank marketing
    "headphonezone",  # sales emails
    "artificialanalysis",  # welcome/newsletter (not the response he cared about)
    "alphasignal",
    "skool",  # Become AI Researcher weekly digest
    "mail.artificialanalysis",
]

# Senders that look like no-reply but are actually important (job alerts the
# user explicitly opted into). Promote these to IMPORTANT unconditionally.
JOB_ALERT_SENDERS = [
    "jobalerts-noreply@linkedin",  # LinkedIn Job Alerts
    "linkedin",  # career-news
    "naukri", "indeed",
    "internshala",
]

# Newsletter-y subjects — even if from a "real" sender, these are digests.
DIGEST_SUBJECT_HINTS = [
    "your daily digest", "weekly digest", "top stories", "trending",
    "new on substack", "new follower", "these are selling fast",
    "cyber security best practices",  # bank's marketing
]


def classify(from_header: str, subject: str, labels: list[str], has_ics: bool) -> tuple[str, str]:
    """Return (tier, reason). tier ∈ {'important','digest','self'}."""
    from_lc = (from_header or "").lower()
    subj_lc = (subject or "").lower()
    labels_lc = [l.lower() for l in labels]

    # Calendar invite → important
    if has_ics:
        return "important", "calendar invite"

    # Gmail's own importance signal wins.
    if "important" in labels_lc:
        return "important", "gmail: important"

    # Promote by opt-in job alerts first (the user wants these even though
    # the sender looks like a bot).
    for pat in JOB_ALERT_SENDERS:
        if pat in from_lc:
            return "important", f"job alert ({pat})"

    # Self-sent test messages — sender is the user himself. We never want
    # to alert on those (they're either accidental or self-test).
    if "telikicherlaadityasasidhar@gmail.com" in from_lc:
        return "self", "self-sent (test/personal)"

    # Demote by sender pattern
    for pat in DEMOTE_SENDERS:
        if pat in from_lc:
            return "digest", f"bot sender ({pat})"

    # Demote by Gmail's category
    for cat in ("category_promotions", "category_updates", "category_forums"):
        if cat in labels_lc:
            return "digest", f"gmail: {cat.split('_', 1)[1]}"

    # Demote by digest subject
    for hint in DIGEST_SUBJECT_HINTS:
        if hint in subj_lc:
            return "digest", "digest subject"

    # Promote by keyword
    for kw in IMPORTANT_KEYWORDS:
        if kw in subj_lc or kw in from_lc:
            return "important", f"keyword: {kw}"

    # Replies (Re:) to real conversations — usually important
    if subj_lc.startswith("re:"):
        # But only if the sender looks like a person, not a bot/repo.
        if "[bot]" not in from_lc and "noreply" not in from_lc and "notifications@" not in from_lc:
            return "important", "reply"

    return "digest", "low signal"


# ---------------------------------------------------------------------------
# IMAP fetch (mirrors the structure of ~/.local/bin/mail)
# ---------------------------------------------------------------------------

def get_token_and_email() -> tuple[str, str]:
    out = subprocess.check_output([os.path.expanduser("~/.local/bin/goa-mail-token")])
    decoded = out.decode("utf-8")
    parts = decoded.split("\x01")
    user = parts[0].removeprefix("user=")
    token = parts[1].removeprefix("auth=Bearer ")
    return user, token


def connect() -> tuple[imaplib.IMAP4_SSL, str]:
    email, token = get_token_and_email()
    imap = imaplib.IMAP4_SSL(IMAP_HOST, 993)
    imap.authenticate(
        "XOAUTH2",
        lambda _: f"user={email}\x01auth=Bearer {token}\x01\x01".encode("utf-8"),
    )
    imap.select("INBOX")
    return imap, email


def fetch_recent(limit: int = 25) -> list[dict]:
    """Return newest `limit` messages as dicts with uid, from, subject, date, labels, has_ics."""
    imap, _ = connect()
    try:
        status, data = imap.uid("SEARCH", None, "ALL")
        if status != "OK" or not data or not data[0]:
            return []
        ids = data[0].decode().split()
        ids = ids[-limit:][::-1]
        out = []
        # Single FETCH for the whole range — far faster than per-uid round trips.
        # imaplib returns a list with one tuple per message in range order.
        if not ids:
            return []
        first, last = ids[-1], ids[0]  # oldest, newest in our (reversed) list
        range_arg = f"{first}:{last}"
        status, data = imap.uid(
            "FETCH", range_arg, "(UID RFC822.HEADER RFC822.SIZE X-GM-LABELS)"
        )
        if status != "OK" or not data:
            return []
        # `data` is interleaved metadata tuples. Group them by UID and build
        # one message per UID.
        per_uid: dict[str, dict] = {}
        for chunk in data:
            if not isinstance(chunk, tuple) or len(chunk) < 2:
                continue
            head, body = chunk[0], chunk[1]
            if not isinstance(head, bytes):
                continue
            muid = re.search(rb"UID (\d+)", head)
            if not muid:
                continue
            uid = muid.group(1).decode()
            slot = per_uid.setdefault(uid, {"labels": [], "header_bytes": b""})
            mu = re.search(rb'X-GM-LABELS \((.*?)\)', head)
            if mu and not slot["labels"]:
                slot["labels"] = [l.decode("utf-8", errors="replace") for l in re.findall(rb'"([^"]*)"', mu.group(1))]
            if isinstance(body, bytes):
                slot["header_bytes"] += body
        # Preserve original order (newest first) by walking `ids` again.
        for uid in ids:
            if uid not in per_uid:
                continue
            slot = per_uid[uid]
            msg = emaillib.message_from_bytes(
                slot["header_bytes"], policy=email.policy.default
            )
            out.append({
                "uid": uid,
                "from": str(msg.get("From", "")),
                "subject": str(msg.get("Subject", "")),
                "date": str(msg.get("Date", "")),
                "labels": slot["labels"],
                "has_ics": False,
            })
        return out
    finally:
        try:
            imap.close()
        except Exception:
            pass
        try:
            imap.logout()
        except Exception:
            pass


def check_ics_batch(uids: list[str]) -> dict[str, bool]:
    """Re-fetch a list of messages and return {uid: has_ics}."""
    result = {uid: False for uid in uids}
    if not uids:
        return result
    imap, _ = connect()
    try:
        for uid in uids:
            try:
                status, data = imap.uid("FETCH", uid, "(BODY.PEEK[1])")
                if status != "OK" or not data or not data[0]:
                    continue
                raw = data[0][1] if isinstance(data[0], tuple) else data[0]
                msg = emaillib.message_from_bytes(raw, policy=email.policy.default)

                def walk(m):
                    if m.is_multipart():
                        return any(walk(c) for c in m.iter_parts())
                    ct = m.get_content_type()
                    fn = (m.get_filename() or "").lower()
                    return ct == "text/calendar" or fn.endswith(".ics")

                result[uid] = walk(msg)
            except Exception:
                result[uid] = False
    finally:
        try:
            imap.close()
        except Exception:
            pass
        try:
            imap.logout()
        except Exception:
            pass
    return result


# ---------------------------------------------------------------------------
# State: avoid re-alerting
# ---------------------------------------------------------------------------

def load_seen() -> set[str]:
    if not SEEN_FILE.exists():
        return set()
    try:
        return set(json.loads(SEEN_FILE.read_text()))
    except Exception:
        return set()


def save_seen(seen: set[str]) -> None:
    SEEN_FILE.write_text(json.dumps(sorted(seen)))


def mark_baseline() -> None:
    """On first ever run, mark current top-of-inbox UIDs as 'seen' so we don't
    flood the user with old mail. Run on a manual --init or via the cron
    wrapper's first-tick detection."""
    items = fetch_recent(limit=40)
    seen = {it["uid"] for it in items}
    save_seen(seen)
    print(f"baseline: marked {len(seen)} UIDs as seen")


# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------

def send_telegram(text: str) -> None:
    """Send via `hermes send telegram` (uses the configured home channel)."""
    import shutil
    if shutil.which("hermes"):
        try:
            subprocess.check_call(
                ["hermes", "send", "-q", "-t", "telegram", text],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.PIPE,
                timeout=30,
            )
            return
        except subprocess.CalledProcessError as e:
            print(f"hermes send failed: {e.stderr.decode()[:300]}", file=sys.stderr)
        except Exception as e:
            print(f"hermes send error: {e}", file=sys.stderr)
    # Last resort: write to a queue file the chat session can pick up
    out = Path.home() / ".local/state/mail_check/last_telegram_msg.txt"
    out.write_text(text)
    print(f"hermes not found; message queued at {out}", file=sys.stderr)


# ---------------------------------------------------------------------------
# Pretty
# ---------------------------------------------------------------------------

def short_from(s: str, n: int = 30) -> str:
    s = s.replace("\n", " ")
    if len(s) > n:
        return s[: n - 1] + "…"
    return s


def fmt_important(items: list[dict]) -> str:
    """A super short telegram message."""
    if not items:
        return ""
    if len(items) == 1:
        it = items[0]
        return f"📬 {short_from(it['from'], 28)}: {it['subject'][:60]}"
    lines = [f"📬 {len(items)} new important:"]
    for it in items[:5]:
        lines.append(f"  • {short_from(it['from'], 22)}: {it['subject'][:50]}")
    if len(items) > 5:
        lines.append(f"  …and {len(items) - 5} more")
    return "\n".join(lines)


def fmt_digest(items: list[dict]) -> str:
    """Quiet summary for the periodic run; sent only if there are >0 new mails."""
    if not items:
        return ""
    by_sender: dict[str, int] = {}
    for it in items:
        # bucket by domain
        m = re.search(r"@([\w.\-]+)", it["from"])
        bucket = m.group(1) if m else it["from"] or "?"
        by_sender[bucket] = by_sender.get(bucket, 0) + 1
    parts = [f"({b}: {n})" for b, n in sorted(by_sender.items(), key=lambda x: -x[1])[:4]]
    return f"  +{len(items)} other: " + " ".join(parts)


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def run_once(verbose: bool = False, dry_run: bool = False) -> None:
    seen = load_seen()
    items = fetch_recent(limit=40)
    new = [it for it in items if it["uid"] not in seen]

    # First pass: classify by header-only signals. Most mail gets demoted here.
    important, digest, self_sent = [], [], []
    for it in new:
        tier, _ = classify(it["from"], it["subject"], it["labels"], False)
        if tier == "important":
            important.append(it)
        elif tier == "self":
            self_sent.append(it)
        else:
            digest.append(it)

    # Second pass: for the small set of "important" candidates, do a body
    # fetch to detect .ics calendar invites — those are the only header-blind
    # promote path left. Skip if it's already obvious (sender match, etc.).
    ics_uids = [it["uid"] for it in important]
    if ics_uids:
        ics = check_ics_batch(ics_uids)
        for it in important:
            if ics.get(it["uid"]):
                it["has_ics"] = True
                # Re-classify; if it didn't already say "calendar invite" we
                # keep the prior tier but mark the flag for the digest line.
        # Re-evaluate just for the ics-promotion reason
        final_important, final_digest = [], []
        for it in important + digest:
            tier, _ = classify(it["from"], it["subject"], it["labels"], it.get("has_ics", False))
            (final_important if tier == "important" else final_digest).append(it)
        important, digest = final_important, final_digest

    # Update seen set
    for it in new:
        seen.add(it["uid"])
    save_seen(seen)

    msg = ""
    if important:
        msg += fmt_important(important)
        tail = fmt_digest(digest)
        if tail:
            msg += "\n" + tail
    elif digest:
        # No important mail — send a quiet "new mail" ping only if it's
        # substantial (>3 new non-bot items) or contains a reply.
        replies = [d for d in digest if d["subject"].lower().startswith("re:")]
        if len(digest) >= 3 or replies:
            msg = fmt_digest(digest)

    # Self-sent: never alert. If the user sent himself a note, mention it
    # in the chat session only — but cron never sees this anyway. For the
    # Telegram path, just keep silent (the user can find self-sent items
    # in their Sent folder).
    # (Currently: self_sent is only consumed when verbose.)

    if msg:
        if dry_run:
            print("TELEGRAM>>", msg)
        else:
            send_telegram(msg)
        if verbose and not dry_run:
            print(msg)
    elif verbose:
        note = ""
        if self_sent:
            subjects = ", ".join(s["subject"][:40] for s in self_sent[:3])
            note = f"  (skipped {len(self_sent)} self-sent: {subjects})"
        print(f"mail_check: {len(new)} new, 0 important, 0 digest-alert{note}")


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--once", action="store_true", help="single run, print result")
    p.add_argument("--dry-run", action="store_true", help="scan but don't send")
    p.add_argument("--init", action="store_true",
                   help="baseline: mark current top-of-inbox as already-seen, then exit")
    p.add_argument("--verbose", "-v", action="store_true")
    args = p.parse_args()
    if args.init:
        mark_baseline()
        return
    if args.dry_run:
        run_once(verbose=args.verbose, dry_run=True)
    else:
        run_once(verbose=args.verbose)


if __name__ == "__main__":
    main()
