# himalaya config — M365 / Outlook OAuth2 account (durable path)
# Copy to ~/.config/himalaya/config.toml and edit all <placeholders>.
# Use this when App Passwords aren't available (most M365 tenants since 2023).
#
# Setup prerequisites:
#   1. Azure app registration: https://portal.azure.com → Entra ID →
#      App registrations → New registration. Type: Web or Mobile+Desktop.
#      Redirect URI for public client: http://127.0.0.1/oauth2/callback
#      (must match the loopback helper you'll run once).
#   2. API permissions: IMAP.AccessAsUser.All (delegated), plus offline_access
#      and openid. Grant admin consent for tenant accounts.
#   3. Use the `outlook-microsoft-graph` umbrella skill (if installed) or a
#      one-shot token script to mint a refresh_token + save it to a chmod 600
#      file; have a helper at /home/arctic/keys/bin/get_outlook_oauth.sh print
#      `user=<email>\x01auth=Bearer <access_token>\x01\x01` on stdout.

[accounts.<purpose>]                # e.g. accounts.work
email = "<full-address>"
display-name = "<your name>"
default = true

backend.type             = "imap"
backend.host             = "outlook.office365.com"
backend.port             = 993
backend.encryption.type  = "tls"
backend.login            = "<full-address>"
backend.auth.type        = "oauth2"
backend.auth.method      = "XOAUTH2"
backend.auth.cmd         = "/home/arctic/keys/bin/get_outlook_oauth.sh"

folder.aliases.inbox   = "INBOX"
folder.aliases.sent    = "Sent Items"
folder.aliases.drafts  = "Drafts"
folder.aliases.trash   = "Deleted Items"
folder.aliases.junk    = "Junk Email"

# Intentionally NO message.send.backend — read-only account.

# Optional send-only account (different scope) — uncomment + fill:
# message.send.backend.type            = "smtp"
# message.send.backend.host            = "smtp.office365.com"
# message.send.backend.port            = 587
# message.send.backend.encryption.type = "start-tls"
# message.send.backend.login           = "<full-address>"
# message.send.backend.auth.type       = "oauth2"
# message.send.backend.auth.method     = "XOAUTH2"
# message.send.backend.auth.cmd        = "/home/arctic/keys/bin/get_outlook_oauth.sh"
