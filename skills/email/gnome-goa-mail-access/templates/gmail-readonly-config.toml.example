# himalaya config — read-only Gmail / Google Workspace account
# Copy to ~/.config/himalaya/config.toml and edit.
# The literal password lives ONLY in /home/arctic/keys/<purpose>_app_password.txt
# (chmod 600, no trailing newline). auth.cmd reads it via a helper that strips
# newlines; see ../templates/passwd-cmd-helper.sh.

[accounts.<purpose>]              # e.g. accounts.vit / accounts.work
email = "<full-address>"
display-name = "<your name>"
default = true                    # exactly ONE account needs default = true

# ---- IMAP backend (Gmail) ----
backend.type            = "imap"
backend.host            = "imap.gmail.com"
backend.port            = 993
backend.encryption.type  = "tls"
backend.login           = "<full-address>"
backend.auth.type       = "password"
backend.auth.cmd        = "/home/arctic/keys/bin/get_imap_passwd.sh"

# ---- Gmail folder aliases (v1.2.0 plural/dotted form ONLY) ----
folder.aliases.inbox    = "INBOX"
folder.aliases.sent     = "[Gmail]/Sent Mail"
folder.aliases.drafts   = "[Gmail]/Drafts"
folder.aliases.trash    = "[Gmail]/Trash"
folder.aliases.junk     = "[Gmail]/Spam"
folder.aliases.archive  = "[Gmail]/All Mail"

# Intentionally NO message.send.backend — read-only account.
# himalaya will refuse to send, which is correct for cron digests.

# ---- Multiple accounts? ----
# Add more [accounts.<name>] sections, each with its own auth.cmd helper.
# Exactly one gets `default = true`; the others left blank so himalaya
# can still enumerate them with `himalaya account list`.
